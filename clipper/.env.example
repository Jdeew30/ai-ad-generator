# Pour un lancement local : copiez en .env (jamais commité). Sur GitHub, mettez les mêmes noms en
# secrets du dépôt. Tout est facultatif : chaque variable active une fonction.

# Twitch (dev.twitch.tv > Console > Applications) : découverte des lives, infos de VOD.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Claude : choisit les meilleurs extraits et écrit accroches, titres et hashtags.
ANTHROPIC_API_KEY=

# YouTube : python -m clipper auth youtube donne le refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok : python -m clipper auth tiktok donne le refresh token.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Telegram : jeton du bot (@BotFather), puis python -m clipper auth telegram pour le chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facultatif : jeton GitHub (droit « Secrets : read and write ») pour enregistrer le refresh token TikTok
# quand TikTok le renouvelle. GITHUB_REPOSITORY est fourni automatiquement dans GitHub Actions.
GH_SECRETS_TOKEN=

# Facultatif : cookies YouTube (format Netscape, contenu ou chemin) si YouTube bloque les téléchargements.
YTDLP_COOKIES=
