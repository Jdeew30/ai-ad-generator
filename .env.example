# ---------------------------------------------------------------------------
# AI Ad Studio — environment. Copy to .env and fill in.
# Only DATABASE_URL, BETTER_AUTH_SECRET and APP_URL are required to boot.
# Everything else enables a feature; when absent, that feature is shown as
# "not configured" in the UI. Nothing is ever simulated.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
DATABASE_URL="postgresql://adstudio:adstudio_dev@localhost:5432/adstudio"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (used for auth cookies/redirects).
APP_URL="http://localhost:3000"

# --- Access control & cost guards -----------------------------------------
# Provider keys are real money: set to "false" to close public sign-up.
ALLOW_SIGNUP="true"
# Max video generations per user per UTC day (counts jobs the provider accepted).
DAILY_GENERATION_LIMIT="5"

# --- Concept generation (LLM) ---------------------------------------------
# Without a key, a deterministic NON-AI template builds the video prompt.
ANTHROPIC_API_KEY=""
# Optional override of the model used for concepts.
ANTHROPIC_MODEL=""

# --- Video providers (set one or more; each unlocks its models) -----------
OPENAI_API_KEY=""        # OpenAI Sora (/v1/videos)
REPLICATE_API_TOKEN=""   # Replicate (multi-model hub)
FAL_KEY=""               # fal.ai (multi-model hub)

# --- Storage ---------------------------------------------------------------
# Local disk driver. Must be a persistent volume in production.
STORAGE_DIR="./.data/storage"

# --- Background sync -------------------------------------------------------
# Bearer secret for GET /api/cron/sync-generations (call it from a cron).
CRON_SECRET=""
