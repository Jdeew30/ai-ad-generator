# Secrets de TradeBot — copiez en .env et ne le partagez jamais.

# Clés API de l'exchange (mode live uniquement).
# Créez-les AVEC le droit de trading et SANS le droit de retrait.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Uniquement pour les exchanges qui l'exigent (OKX, KuCoin...)
EXCHANGE_API_PASSWORD=

# Telegram : token donné par @BotFather, chat_id donné par @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mot de passe du tableau de bord (long et unique)
DASHBOARD_PASSWORD=

# Confirmation du mode argent réel sans terminal (Docker). Laisser vide sinon.
CONFIRM_REAL_MONEY=
